# Anthropic API key — powers both the LLM provider and the web_search tool.
# Required for a real run. Without it the pipeline falls back to mock providers
# (only useful for tests / structural dry-runs).
ANTHROPIC_API_KEY=

# Optional overrides
# DRY_RUN=true          # research + write, but no commit / push / publish
# FORCE_UPDATE=true     # allow overwriting an existing same-day report
# LLM_MODEL=claude-opus-5
