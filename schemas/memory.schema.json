{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "memory.schema.json",
  "title": "Memory",
  "definitions": {
    "topicEntry": {
      "type": "object",
      "required": ["slug", "title", "last_updated", "reports", "status"],
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "last_updated": { "type": "string" },
        "reports": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["active", "archived"] },
        "categories": { "type": "array", "items": { "type": "string" } },
        "companies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "thesisEntry": {
      "type": "object",
      "required": ["id", "topic", "statement", "confidence", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string" },
        "topic": { "type": "string" },
        "statement": { "type": "string" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "supporting_reports": { "type": "array", "items": { "type": "string" } },
        "kill_conditions": { "type": "array" }
      }
    },
    "watchlistEntry": {
      "type": "object",
      "required": ["event", "expected_window", "origin_report"],
      "properties": {
        "event": { "type": "string" },
        "expected_window": { "type": "string" },
        "supports_if": { "type": "string" },
        "weakens_if": { "type": "string" },
        "source_to_monitor": { "type": "string" },
        "origin_report": { "type": "string" },
        "status": { "enum": ["open", "triggered", "expired"] }
      }
    },
    "companyEntry": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "reports": { "type": "array", "items": { "type": "string" } },
        "last_updated": { "type": "string" }
      }
    }
  },
  "properties": {
    "topics": { "type": "array", "items": { "$ref": "#/definitions/topicEntry" } },
    "theses": { "type": "array", "items": { "$ref": "#/definitions/thesisEntry" } },
    "watchlist": { "type": "array", "items": { "$ref": "#/definitions/watchlistEntry" } },
    "companies": { "type": "array", "items": { "$ref": "#/definitions/companyEntry" } }
  }
}
