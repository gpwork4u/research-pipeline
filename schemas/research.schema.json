{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "research.schema.json",
  "title": "ResearchData",
  "type": "object",
  "required": [
    "topic",
    "questions",
    "thesis",
    "facts",
    "inferences",
    "unknowns",
    "bottlenecks",
    "bear_case",
    "kill_conditions",
    "validation_events",
    "sources"
  ],
  "properties": {
    "topic": {
      "type": "object",
      "required": ["title", "slug", "date", "research_type"],
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "research_type": { "enum": ["NEW", "UPDATE", "FOLLOW_UP"] },
        "categories": { "type": "array", "items": { "type": "string" } },
        "score": { "type": "number" },
        "trigger": { "type": "string" }
      }
    },
    "questions": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string", "minLength": 5 },
        "sub": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
      }
    },
    "thesis": { "type": "string", "minLength": 10 },
    "facts": { "type": "array", "items": { "$ref": "#/definitions/statement" } },
    "inferences": { "type": "array", "items": { "$ref": "#/definitions/statement" } },
    "unknowns": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          { "$ref": "#/definitions/statement" }
        ]
      }
    },
    "industry_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "major_players": { "type": "array", "items": { "type": "string" } },
          "pricing_power": { "type": ["string", "null"] },
          "supply_elasticity": { "type": ["string", "null"] },
          "substitutability": { "type": ["string", "null"] }
        }
      }
    },
    "bottlenecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "classification"],
        "properties": {
          "node": { "type": "string" },
          "demand_growth": { "enum": ["Low", "Medium", "High", "Extreme", null] },
          "supply_elasticity": { "enum": ["Low", "Medium", "High", "Extreme", null] },
          "expansion_time": { "type": ["string", "null"] },
          "substitutability": { "enum": ["Easy", "Medium", "Hard", null] },
          "pricing_power": { "enum": ["Low", "Medium", "High", "Extreme", null] },
          "market_attention": { "enum": ["Low", "Medium", "High", "Extreme", null] },
          "profit_capture": { "enum": ["Low", "Medium", "High", "Extreme", null] },
          "opportunity_score": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
          "classification": { "enum": ["Structural Bottleneck", "Growth Area", "Neutral"] },
          "rationale": { "type": "string" }
        }
      }
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "business_model": { "type": ["string", "null"] },
          "revenue_model": { "type": ["string", "null"] },
          "cost_structure": { "type": ["string", "null"] },
          "gross_margin": { "type": ["string", "number", "null"] },
          "operating_margin": { "type": ["string", "number", "null"] },
          "growth_drivers": { "type": ["array", "null"], "items": { "type": "string" } },
          "customer_concentration": { "type": ["string", "null"] },
          "moat": { "type": ["string", "null"] },
          "switching_costs": { "type": ["string", "null"] },
          "capital_intensity": { "type": ["string", "null"] },
          "management_strategy": { "type": ["string", "null"] },
          "execution_risk": { "type": ["string", "null"] }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source_id"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": ["number", "string", "null"] },
          "unit": { "type": ["string", "null"] },
          "period": { "type": ["string", "null"] },
          "growth": { "type": ["number", "string", "null"] },
          "source_id": { "type": "string" }
        }
      }
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string" },
          "kind": {
            "enum": [
              "direct competitor",
              "indirect alternative",
              "internal build",
              "manual process",
              "status quo"
            ]
          },
          "note": { "type": "string" }
        }
      }
    },
    "financials": { "type": "array", "items": { "type": "object" } },
    "valuation": {
      "anyOf": [
        { "type": "array" },
        {
          "type": "object",
          "required": ["available"],
          "properties": {
            "available": { "type": "boolean" },
            "reason": { "type": "string" }
          }
        }
      ]
    },
    "catalysts": { "type": "array", "items": { "type": "string" } },
    "bear_case": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dimension", "argument"],
        "properties": {
          "dimension": {
            "enum": [
              "Technology",
              "Demand",
              "Supply",
              "Competition",
              "Regulation",
              "Economics",
              "Execution",
              "Valuation"
            ]
          },
          "argument": { "type": "string", "minLength": 10 }
        }
      }
    },
    "kill_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["condition", "metric", "threshold", "time_window", "impact"],
        "properties": {
          "condition": { "type": "string" },
          "metric": { "type": "string" },
          "threshold": { "type": "string" },
          "time_window": { "type": "string" },
          "impact": { "enum": ["invalidate", "weaken"] }
        }
      }
    },
    "validation_events": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["event", "expected_window", "supports_if", "weakens_if"],
        "properties": {
          "event": { "type": "string" },
          "expected_window": { "type": "string" },
          "supports_if": { "type": "string" },
          "weakens_if": { "type": "string" },
          "source_to_monitor": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence" }
    },
    "verdict": { "enum": ["BUILD NOW", "VALIDATE", "PAUSE", null] },
    "confidence": { "enum": ["low", "medium", "high", null] }
  },
  "definitions": {
    "statement": {
      "type": "object",
      "required": ["statement", "type"],
      "properties": {
        "statement": { "type": "string", "minLength": 5 },
        "type": { "enum": ["FACT", "INFERENCE", "UNKNOWN"] },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "confidence": { "enum": ["low", "medium", "high"] }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "claim", "source_url", "source_title", "source_type"],
      "properties": {
        "id": { "type": "string" },
        "claim": { "type": "string" },
        "source_url": { "type": "string" },
        "source_title": { "type": "string" },
        "source_type": { "enum": ["primary", "secondary", "discovery"] },
        "published_at": { "type": ["string", "null"] },
        "retrieved_at": { "type": ["string", "null"] },
        "quote_or_extract": { "type": ["string", "null"] },
        "confidence": { "enum": ["low", "medium", "high", null] }
      }
    }
  }
}
